[Unit]
Description=Compressed swap for Kinosreda rembg
Before=kinosreda-rembg.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /opt/kinosreda-realtime/scripts/realtime/ensure_rembg_swap.sh
# Keep swap available when this oneshot unit is stopped or upgraded.

[Install]
WantedBy=multi-user.target
